HYBRID_MODEL_DIR=/absolute/path/to/private/tomatocare_hybrid_bundle
HYBRID_CORS_ORIGINS=http://localhost:5173
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
# Optional private remote bootstrap. Keep repo empty/unset for Phase 5 local mode.
# HYBRID_HF_REPO=ThanhHai25/TomatoCare-Hybrid-ONNX-Private
# HYBRID_HF_REVISION=  # required: full immutable 40-character HF repository commit
# HF_TOKEN=           # supply securely in Kaggle/Render, never in source control
# HYBRID_EXPECTED_ONNX_SHA256=196c46f385414800a9233650661ef102d3407bbaca0a69da908222c4f504f4c4
# In remote mode HYBRID_MODEL_DIR is an ephemeral bootstrap parent, e.g. /tmp/tomatocare-hybrid.
# HF_HOME=/tmp/huggingface
# HF_HUB_DISABLE_XET=1
# HF_HUB_DISABLE_PROGRESS_BARS=1
